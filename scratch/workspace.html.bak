                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" x2="16.65" y1="21" y2="16.65" />
                </svg>
                <input type="text" class="vault-search-input" id="vaultSearchInput"
                  placeholder="Filter documents by name, tag, or format..." />
              </div>

              <div class="vault-filter-pills" id="vaultFilterPills">
                <button type="button" class="vault-filter-btn active" data-filter="all">All Documents (<span
                    id="countFilterAll">4</span>)</button>
                <button type="button" class="vault-filter-btn" data-filter="pdf">PDF Specs</button>
                <button type="button" class="vault-filter-btn" data-filter="json">Schemas</button>
                <button type="button" class="vault-filter-btn" data-filter="doc">Requirements</button>
              </div>
            </div>

            <!-- Documents Table -->
            <div class="vault-table-wrapper">
              <table class="vault-documents-table">
                <thead>
                  <tr>
                    <th style="width: 32px;"><input type="checkbox" id="chkVaultSelectAll" title="Select all" /></th>
                    <th>Document Name</th>
                    <th>Category / Tag</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th>Usage Count</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                  </tr>
                </thead>
                <tbody id="vaultDocsTableBody">
                  <!-- Dynamically populated via JavaScript -->
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ==========================================
       MODAL 1: SELECT CONTEXT DOCUMENTS (FOR CHAT BUILD)
       ========================================== -->
    <div class="zenith-modal-backdrop" id="contextSelectModalBackdrop" role="dialog" aria-modal="true"
      aria-labelledby="contextSelectModalTitle">
      <div class="zenith-modal-window context-select-modal-window">
        <!-- Modal Header -->
        <div class="modal-header-bar">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <div class="modal-header-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
              </svg>
            </div>
            <div>
              <h2 class="modal-header-title" id="contextSelectModalTitle">Select Reusable Context Documents</h2>
              <span class="modal-header-sub">Choose documents from your vault to feed into the active AI Build
                session.</span>
            </div>
          </div>
          <button type="button" class="modal-close-btn" id="btnContextModalClose" aria-label="Close modal">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <!-- Modal Search & Quick Upload Toolbar -->
        <div class="context-modal-toolbar">
          <div class="context-modal-search">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" x2="16.65" y1="21" y2="16.65" />
            </svg>
            <input type="text" class="context-search-input" id="contextModalSearchInput"
              placeholder="Search context documents..." />
          </div>

          <button type="button" class="btn-quick-upload-modal" id="btnQuickUploadModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            <span>+ Upload New</span>
          </button>
        </div>

        <!-- Modal Document Checklist List -->
        <div class="context-modal-body">
          <div class="context-docs-checklist" id="contextDocsChecklist">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <!-- Modal Footer Bar -->
        <div class="context-modal-footer">
          <div class="context-modal-selection-count">
            <span id="modalSelectedCountText">0 documents selected</span>
          </div>
          <div class="context-modal-actions">
            <button type="button" class="btn-cancel-modal" id="btnCancelContextModal">Cancel</button>
            <button type="button" class="btn-attach-modal-cta" id="btnApplyContextModal">
              <span>Attach to AI Prompt</span>
              <span class="btn-badge-count" id="btnModalApplyCount">0</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ==========================================
       MODAL 2: DOCUMENT QUICK PREVIEW MODAL
       ========================================== -->
    <div class="zenith-modal-backdrop" id="docQuickPreviewModalBackdrop" role="dialog" aria-modal="true">
      <div class="zenith-modal-window doc-preview-modal-window">
        <div class="modal-header-bar">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span class="preview-doc-type-icon" id="previewModalDocIcon">📄</span>
            <div>
              <h2 class="modal-header-title" id="previewModalDocTitle">Document Preview</h2>
              <span class="modal-header-sub" id="previewModalDocMeta">Size: 245 KB · Uploaded today</span>
            </div>
          </div>
          <button type="button" class="modal-close-btn" id="btnDocPreviewClose" aria-label="Close preview">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <div class="doc-preview-modal-content">
          <pre class="doc-preview-text-block" id="docPreviewTextBlock">
Loading document content...
          </pre>
        </div>

        <div class="modal-preview-footer">
          <button type="button" class="btn-copy-doc-ref" id="btnCopyDocRefFromModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <span>Copy Reference Tag</span>
          </button>
          <button type="button" class="btn-attach-direct-from-modal" id="btnAttachDirectFromModal">
            <span>+ Attach to Current Build</span>
          </button>
        </div>
      </div>
    </div>

