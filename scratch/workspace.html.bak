                    <circle cx="15" cy="5" r="1" />
                    <circle cx="15" cy="12" r="1" />
                    <circle cx="15" cy="19" r="1" />
                  </svg>
                  <span>Drag to Chat</span>
                </div>
              </div>
            </div>

            <!-- Beauty Store Navbar -->
            <header class="beauty-nav orca-interactive-el" data-orca-component="navbar"
              data-component-name="Store Navbar" draggable="true">
