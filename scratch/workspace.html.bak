              </div>

              <div class="pm-timeline-controls">
                <button type="button" class="btn-timeline-tool" id="btnViewByTasks">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                  </svg>
                  <span>View by Tasks</span>
                </button>

                <div class="timeline-zoom-pill">
                  <button type="button" class="btn-zoom-step" id="btnZoomOut" title="Zoom out">−</button>
                  <span class="zoom-pct-display" id="zoomLevelDisplay">100%</span>
                  <button type="button" class="btn-zoom-step" id="btnZoomIn" title="Zoom in">+</button>
                </div>

                <button type="button" class="btn-timeline-tool" id="btnTimelineExpand" title="Toggle Fullscreen">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <polyline points="15 3 21 3 21 9" />
                    <polyline points="9 21 3 21 3 15" />
                    <line x1="21" y1="3" x2="14" y2="10" />
                    <line x1="3" y1="21" x2="10" y2="14" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Gantt Table / Matrix -->
            <div class="pm-gantt-scrollable" id="ganttScrollable">
              <table class="pm-gantt-table">
                <thead>
                  <tr>
                    <th class="col-phase-label">Phase / Sprint</th>
                    <th class="col-week">W1</th>
                    <th class="col-week">W2</th>
                    <th class="col-week">W3</th>
                    <th class="col-week">W4</th>
                    <th class="col-week">W5</th>
                    <th class="col-week">W6</th>
                    <th class="col-week">W7</th>
                    <th class="col-week">W8</th>
                    <th class="col-week">W9</th>
                    <th class="col-week">W10</th>
                    <th class="col-week">W11</th>
                    <th class="col-week">W12+</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- Row S0 -->
                  <tr>
                    <td class="col-phase-label" title="S0 Solution Blueprint (W1 -> W2) - *tanpa pembangunan fitur*">
