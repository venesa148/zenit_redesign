              <!-- Subtab Content: Overview -->
              <div class="prd-subtab-pane active" id="prdSubtab-overview">
                <div class="doc-summary-intro">
                  <h2 class="doc-section-headline">Ringkasan</h2>
                  <p class="doc-section-desc">Dokumen ini mendefinisikan apa yang akan dibangun, untuk siapa, dan
                    mengapa.</p>
                </div>

                <!-- 6-Card Grid Matching Reference Image -->
                <div class="prd-cards-grid">
                  <!-- Card 1: Problem Statement -->
                  <div class="prd-box-card">
                    <div class="prd-card-header">
                      <div class="prd-icon-box icon-purple">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                          <line x1="16" y1="13" x2="8" y2="13" />
                          <line x1="16" y1="17" x2="8" y2="17" />
                        </svg>
                      </div>
                      <h3 class="prd-card-title">Problem Statement</h3>
                    </div>
                    <p class="prd-card-content">
                      Proses distribusi PAD saat ini masih manual dan terpisah antar unit, menyebabkan data tidak
                      akurat, pelaporan lambat, dan kontrol keuangan lemah.
                    </p>
                  </div>

                  <!-- Card 2: Product Vision -->
                  <div class="prd-box-card">
                    <div class="prd-card-header">
                      <div class="prd-icon-box icon-green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                          <circle cx="12" cy="12" r="3" />
                        </svg>
                      </div>
                      <h3 class="prd-card-title">Product Vision</h3>
                    </div>
                    <p class="prd-card-content">
                      Membangun platform ERP terintegrasi untuk mengelola distribusi PAD secara akurat, transparan, dan
                      real-time.
                    </p>
                  </div>

                  <!-- Card 3: Target Users -->
                  <div class="prd-box-card">
                    <div class="prd-card-header">
                      <div class="prd-icon-box icon-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2">
                          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                          <circle cx="9" cy="7" r="4" />
                          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                      </div>
                      <h3 class="prd-card-title">Target Users</h3>
                    </div>
                    <p class="prd-card-content">
                      Admin, Finance, Accounting, Sales, Warehouse, Procurement, Production.
                    </p>
                  </div>

                  <!-- Card 4: Scope (In) -->
                  <div class="prd-box-card">
                    <div class="prd-card-header">
                      <div class="prd-icon-box icon-green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="16 12 12 8 8 12" />
                          <line x1="12" x2="12" y1="16" y2="8" />
                        </svg>
                      </div>
                      <h3 class="prd-card-title">Scope (In)</h3>
                    </div>
                    <p class="prd-card-content">
                      Manajemen master data, sales order, distribusi, persediaan, pembelian, keuangan, akuntansi, pajak,
                      laporan, produksi.
                    </p>
                  </div>

                  <!-- Card 5: Scope (Out) -->
                  <div class="prd-box-card">
                    <div class="prd-card-header">
