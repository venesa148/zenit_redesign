                <p class="doc-section-desc">Instruksi setup local environment dan eksekusi project.</p>

                <div class="md-code-block">
                  <button type="button" class="md-code-copy-btn">Copy</button>
                  # Clone repository
                  git clone https://github.com/zenith-ai/zenith-core.git
                  cd zenith-core

                  # Start infrastructure (Postgres, Redis, RabbitMQ)
                  docker-compose up -d

                  # Install dependencies & run development server
                  npm install
                  npm run dev
                </div>
