    <script src="js/modal.js"></script>
  <!-- ==========================================
       PHASE DETAILS MODAL
       ========================================== -->
  <div class="zenith-modal-backdrop active" id="phaseDetailsModal">
    <div class="zenith-modal-window phase-modal-window">
      <div class="modal-header-bar">
        <div class="modal-header-left">
          <div class="phase-modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8c-1.1 0-1.99.9-1.99 2L6 20a2 2 0 0 0 2 2z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><polyline points="14 13 18 17 22 13"></polyline></svg>
          </div>
          <h2 class="modal-header-title">Phase Overview: Gates & Checklist</h2>
        </div>
        <button type="button" class="modal-close-btn" id="btnClosePhaseModal" onclick="document.getElementById('phaseDetailsModal').classList.remove('active')">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="modal-body-layout phase-modal-body">
        <!-- Sidebar -->
        <div class="modal-inner-sidebar phase-modal-sidebar">
          <button type="button" class="modal-nav-item active phase-nav-item" data-phase="1">
            <span class="phase-nav-number">1</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Business & Planning</span>
              <span class="phase-nav-meta">0/9 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="2">
            <span class="phase-nav-number">2</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Design</span>
              <span class="phase-nav-meta">0/15 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="3">
            <span class="phase-nav-number">3</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Development</span>
              <span class="phase-nav-meta">0/11 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="4">
            <span class="phase-nav-number">4</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Validation & Acceptance</span>
              <span class="phase-nav-meta">0/9 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="5">
            <span class="phase-nav-number">5</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Release</span>
              <span class="phase-nav-meta">0/9 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="6">
            <span class="phase-nav-number">6</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Operations</span>
              <span class="phase-nav-meta">0/7 Gates Cleared</span>
            </div>
          </button>
          <button type="button" class="modal-nav-item phase-nav-item" data-phase="7">
            <span class="phase-nav-number">7</span>
            <div class="phase-nav-text">
              <span class="phase-nav-title">Continuous Improvement</span>
              <span class="phase-nav-meta">0/6 Gates Cleared</span>
            </div>
          </button>
        </div>

        <!-- Content (Rendered by JS) -->
        <div class="modal-content-pane phase-modal-content" id="phaseContentRoot">
        </div>
      </div>
    </div>
  </div>

  <script>
    const phaseData = [
      {
        id: 1,
        title: "Business & Planning",
        owner: "business-analyst",
        status: "Pending",
        gates: 9,
        items: [
          "Every §D story has EARS/GWT acceptance criteria, testable and tech-free",
          "<strong>Fully decided:</strong> zero <code>[NEEDS CLARIFICATION]</code> / \"TBD\" / \"Pending\" anywhere in this doc — every unknown is resolved (§H) or registered (§J). The gate-guard hook enforces this mechanically.",
          "§H decision log reflects every interview decision; no duplicate or dangling SD-n",
          "§I glossary defines every term §A–§G use; controlled vocabularies enumerated in full",
          "Scope: in/out lists complete; MVP cut line drawn <em>(skippable in quick mode)</em>",
          "Roadmap + WBS present and consistent with scope <em>(skippable in quick mode)</em>",
          "Constitution Check passed (no §1–§7 conflicts)",
          "Reviewed by product-manager agent (not the drafting author)",
          "Every item above genuinely met — the owning agent approves and advances (agent-owned gate, constitution §2)"
        ]
      },
      {
        id: 2,
        title: "Design",
        owner: "software-architect",
        status: "Pending",
        gates: 15,
        items: [
          "Architecture, schema, API, and sequence diagrams complete and consistent with each other",
          "Every PRD must-story is covered by design elements (traceability table filled)",
          "RLS policies defined for all tables; public endpoint surface enumerated",
          "Permission matrix, event catalog, and notification matrix present — filled or explicitly \"N/A (DD-n)\"",
          "Stack follows constitution §8 primary; commons stack was announced and only hard-constraint deviations recorded as DD-n (never a technology menu)",
          "Architecture shape locked as DD-n (modular monolith default, or microservices with Gate A/B + five must-haves)",
          "§E documents dual Docker modes (dev hot-reload compose vs staging/prod image-run) and the Jenkins job map",
          "Threat model reviewed by security-architect <em>(Security Team hook — never skippable)</em>",
          "Test strategy defined with measurable performance targets",
          "<strong>UI/UX: 2–4 distinct template directions were presented in Preview and the user selected & locked one</strong> <em>(human choice — never skippable)</em>",
          "Design system captured in <code>docs/design/ui-system.md</code> (tokens, components, do/don'ts) and referenced for development",
          "<code>docs/sprints.md</code> written and <strong>user-confirmed</strong>: tasks cite <code>US-n</code>/<code>DD-n</code>, every task tagged <code>(FE)</code>/<code>(BE)</code>/<code>(FE+BE)</code>, every sprint has verifiable exit criteria",
          "<strong>Fully decided:</strong> zero <code>[NEEDS CLARIFICATION]</code> / \"TBD\" / \"Pending\" in this doc — new unknowns were resolved as DD-n or routed to the Phase-1 §J registry",
          "Architecture Review hook: independent architect agent reviewed §A–§E <em>(skippable in quick mode)</em>",
          "Every item above genuinely met — the owning agent approves and advances"
        ]
      },
      {
        id: 3,
        title: "Development",
        owner: "frontend-engineer + backend-engineer",
        status: "Pending",
        gates: 11,
        items: [
          "Every sprint in <code>docs/sprints.md</code> complete: all tasks <code>[x]</code>, or explicitly moved to <code>docs/backlog.md</code> with the user's consent",
          "Every sprint's <code>Exit:</code> criteria verified with real evidence (output cited in the Review log)",
          "Every sprint's <code>Validation:</code> line reads <code>passed</code> (Phase 4 manual round); no open blocking <code>DEF-n</code>",
          "Review log complete: every merged change has a non-author <em>approve</em> row",
          "Containerized quality gates green (typecheck · lint · tests · build); Jenkins <strong>verify</strong> green if CI is connected",
          "Traceability intact: every must-<code>US-n</code> maps to done tasks; every task cites <code>US-n</code>/<code>DD-n</code>/<code>BL-n</code>/<code>DEF-n</code> and carries an <code>(FE)</code>/<code>(BE)</code>/<code>(FE+BE)</code> tag",
          "Docs in sync: phase docs match built behavior (tech-lead spot-check)",
          "<code>dev</code> environment runs the integrated build via hot-reload compose (design §E)",
          "<strong>Fully decided:</strong> zero <code>[NEEDS CLARIFICATION]</code>/TBD/Pending — unknowns resolved (DD-n) or registered (§J)",
          "Constitution Check passed",
          "Every item above genuinely met — the owning agents approve and advance"
        ]
      },
      {
        id: 4,
        title: "Validation & Acceptance",
        owner: "human",
        status: "Pending",
        gates: 9,
        items: [
          "Every sprint has a recorded manual validation round with the human's own results; every <code>Validation:</code> line reads <code>passed</code>",
          "100% of must-story criteria covered by executed, passing checks",
          "Regression: previously-validated sprints re-checked after later changes",
          "Performance targets met (numbers recorded) <em>(skippable in quick mode)</em>",
          "Security battery executed; zero open critical/high defects <strong>(never skippable)</strong>",
          "All open defects triaged: fixed, or explicitly waived by approver with rationale",
          "Test reports + defect log complete in this doc",
          "UAT executed with acceptance evidence recorded (never skippable)",
          "Every item above genuinely met — the owning agent approves and advances"
        ]
      },
      {
        id: 5,
        title: "Release",
        owner: "release-manager",
        status: "Pending",
        gates: 9,
        items: [
          "Version tagged; release notes complete and traceable (US-n / DEF-n)",
          "Staging deploy green + smoke evidence attached",
          "Rollback rehearsed on staging with recorded result <strong>(never skippable)</strong>",
          "Migrations reversible; restore point confirmed",
          "Monitoring & alerts verified receiving staging/production data",
          "Deployment logs recorded for every environment",
          "Production-deploy readiness verified and recorded (never skippable)",
          "Production smoke checks passed post-deploy",
          "Every item above genuinely met — the owning agent approves and advances"
        ]
      },
      {
        id: 6,
        title: "Operations",
        owner: "sre",
        status: "Pending",
        gates: 7,
        items: [
          "Monitoring live: golden-signals table complete, alerts tested end-to-end",
          "All incidents this cycle logged with root cause + follow-ups routed",
          "All SEV-1/2 post-incident reviews written",
          "Backup restore verified within the cycle",
          "Maintenance log current; no overdue critical patches",
          "Ops summary (uptime, incident count, alert noise, cost) prepared for retro",
          "Every item above genuinely met — the owning agent approves and advances"
        ]
      },
      {
        id: 7,
        title: "Continuous Improvement",
        owner: "engineering-manager",
        status: "Pending",
        gates: 6,
        items: [
          "Retro report complete with evidence-cited findings",
          "Every <code>IMP-n</code> routed (constitution / template / backlog / runbook / memory) with owner",
          "Constitution amendment proposals submitted where warranted",
          "Platform memory + <code>AGENTS.md</code>/<code>CLAUDE.md</code> updated",
          "Next-cycle backlog seeded (or closure: handover + closure report complete, hypercare dated)",
          "Every item above genuinely met — the owning agent approves and advances"
        ]
      }
    ];
  
    function renderPhase(id) {
      const phase = phaseData.find(p => p.id === id);
      if (!phase) return;
  
      // Update active state on sidebar
      document.querySelectorAll('.phase-nav-item').forEach(el => {
        el.classList.toggle('active', parseInt(el.getAttribute('data-phase')) === id);
      });
  
      const root = document.getElementById('phaseContentRoot');
      
      let itemsHtml = phase.items.map(item => `
        <label class="gate-item">
          <input type="checkbox" class="gate-checkbox" disabled />
          <span class="gate-text">${item}</span>
        </label>
      `).join('');
  
      root.innerHTML = `
        <div class="phase-content-header">
          <div>
            <h3 class="section-main-heading">${phase.id}. ${phase.title}</h3>
            <p class="section-sub-desc phase-owner-desc">
              Owner: <span class="owner-pill"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg> ${phase.owner}</span>
              <span class="phase-status-pill pending">${phase.status}</span>
            </p>
          </div>
          <div class="phase-progress-box">
            <div class="progress-big">0<span class="progress-small">/${phase.gates}</span></div>
            <div class="progress-label">Gates cleared</div>
          </div>
        </div>
        
        <div class="phase-gates-list">
          ${itemsHtml}
        </div>
        
        <div class="phase-action-bar">
          <button class="btn-modal-dark-cta phase-advance-btn" disabled>
            Advance Phase
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <p class="phase-action-note">Only the owner agent (<strong>${phase.owner}</strong>) can advance this phase after clearing all gates.</p>
        </div>
      `;
    }
  
    // Add click listeners
    document.querySelectorAll('.phase-nav-item').forEach(el => {
      el.addEventListener('click', () => {
        renderPhase(parseInt(el.getAttribute('data-phase')));
      });
    });
  
    // Initial render
    if (document.getElementById('phaseContentRoot')) {
      renderPhase(1);
    }
  </script>
</body>

</html>