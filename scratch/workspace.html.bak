          <!-- Toast Notification for Add to Bag Action -->
          <div class="beauty-toast-msg" id="beautyToast">
            <span>🌸</span>
            <span id="beautyToastText">Added to bag!</span>
          </div>

          <!-- ==========================================
               OPEN EDITOR: CODE EDITOR VIEWPORT
               Dynamically displays syntax-highlighted code for opened document tabs
               ========================================== -->
          <div class="code-editor-viewport" id="codeEditorViewport" style="display: none;">
            <div class="editor-main-canvas">
              <div class="editor-line-numbers" id="editorLineNumbers">
                <!-- Dynamically generated line numbers 1..N -->
              </div>
              <div class="editor-code-area" id="editorCodeArea">
                <pre class="editor-pre"
                  id="editorCodePre"><code class="editor-code" id="editorCodeContent"></code></pre>
              </div>
            </div>
            <!-- Editor Bottom Status Bar -->
            <div class="editor-status-bar" id="editorStatusBar">
              <div class="status-left">
                <span id="editorStatusLines">42 lines</span>
                <span class="status-dot-sep">&middot;</span>
                <span id="editorStatusEncoding">UTF-8</span>
                <span class="status-dot-sep">&middot;</span>
                <span id="editorStatusType">React 19 JSX</span>
              </div>
              <div class="status-right">
                <span>Ln 1, Col 1</span>
                <span class="status-dot-sep">&middot;</span>
                <span>Spaces: 2</span>
              </div>
            </div>
          </div>

          <!-- ==========================================
               BOTTOM PANEL (DRAWER): RUNTIME & BUILD LOGS
               Half-screen default, resizable via top drag handle
               ========================================== -->
          <div class="preview-log-drawer" id="previewLogDrawer" aria-label="Runtime Logs Console">
            <!-- Top Resize Handle (Drag vertically to adjust height) -->
            <div class="log-drawer-resizer" id="logDrawerResizer" title="Drag to resize log panel">
              <div class="log-drawer-resizer-handle"></div>
            </div>

            <!-- Drawer Header -->
            <div class="log-drawer-header">
              <div class="log-header-left">
                <span class="log-header-indicator"></span>
                <span class="log-header-title">Runtime &amp; Build Logs</span>
                <span class="log-badge-process">node watch · port 3000</span>
              </div>

              <div class="log-header-controls">
                <!-- Log Level Filters -->
                <div class="log-filter-group">
                  <button type="button" class="log-filter-btn active" data-filter="all">All</button>
                  <button type="button" class="log-filter-btn" data-filter="info">Info</button>
                  <button type="button" class="log-filter-btn" data-filter="warn">Warn</button>
                  <button type="button" class="log-filter-btn" data-filter="error">Error</button>
                </div>

                <!-- Clear Logs -->
                <button type="button" class="log-control-btn" id="btnClearLogs" title="Clear console logs">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                  </svg>
                </button>

                <!-- Quick Height Toggle (Half / Max) -->
                <button type="button" class="log-control-btn" id="btnLogToggleHeight" title="Toggle expand height">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="18 15 12 9 6 15" />
                  </svg>
                </button>

                <!-- Close Drawer Button -->
                <button type="button" class="log-control-btn log-close-btn" id="btnCloseLogDrawer"
                  title="Close log panel">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Log Terminal Console Stream Body -->
            <div class="log-drawer-body" id="logDrawerBody">
              <div class="log-entry" data-level="vite">
                <span class="log-time">[18:58:01]</span>
                <span class="log-tag vite">VITE</span>
                <span class="log-msg">⚡ <span style="color:#f1f5f9;font-weight:600;">Vite v5.4.2</span> dev server
                  running with React 19 Fast Refresh</span>
              </div>
              <div class="log-entry" data-level="info">
                <span class="log-time">[18:58:02]</span>
                <span class="log-tag info">LOCAL</span>
                <span class="log-msg">Server listening at <a href="#"
                    class="highlight-url">http://localhost:3000/</a></span>
              </div>
              <div class="log-entry" data-level="info">
                <span class="log-time">[18:58:02]</span>
                <span class="log-tag info">NETWORK</span>
                <span class="log-msg">Network route ready at <a href="#"
                    class="highlight-url">http://192.168.1.14:3000/</a></span>
              </div>
              <div class="log-entry" data-level="success">
                <span class="log-time">[18:58:04]</span>
                <span class="log-tag success">DATABASE</span>
                <span class="log-msg">PostgreSQL compose container healthy &middot; <span
                    style="color:#94a3b8;">postgres://zenith:***@localhost:5432/coba_db</span></span>
              </div>
              <div class="log-entry" data-level="info">
                <span class="log-time">[18:58:05]</span>
                <span class="log-tag info">HMR</span>
                <span class="log-msg">WebSocket client connected to live preview viewport</span>
              </div>
              <div class="log-entry" data-level="vite">
                <span class="log-time">[18:58:12]</span>
                <span class="log-tag vite">COMPILED</span>
                <span class="log-msg">Synthesized <span style="color:#38bdf8;">/app/page.jsx</span> &amp; <span
                    style="color:#38bdf8;">/app/components/BeautyCard.jsx</span> in <span
                    class="highlight-time">34ms</span></span>
              </div>
              <div class="log-entry" data-level="info">
                <span class="log-time">[18:58:15]</span>
                <span class="log-tag info">HTTP</span>
                <span class="log-msg">GET <span style="color:#34d399;">/api/products</span> &rarr; 200 OK (3 items,
                  14ms)</span>
              </div>
              <div class="log-entry" data-level="warn">
                <span class="log-time">[18:58:18]</span>
                <span class="log-tag warn">WARN</span>
                <span class="log-msg">Image asset &lsquo;peony-dew.webp&rsquo; using fallback vector graphic</span>
              </div>
              <div class="log-entry" data-level="success">
                <span class="log-time">[18:58:22]</span>
                <span class="log-tag success">READY</span>
                <span class="log-msg">Ready for interactive visual editing, live preview &amp; AI chat
                  instructions</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ==========================================
             FILE EXPLORER SIDEBAR (RIGHT SIDE)
             Placed on right side of Preview panel
             ========================================== -->
        <aside class="file-explorer-sidebar" id="fileExplorerSidebar" aria-label="Project File Explorer">
          <!-- Explorer Top Header -->
          <div class="explorer-header">
            <div class="explorer-header-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
              </svg>
              <span class="explorer-title">Files</span>
              <span class="explorer-badge">Project</span>
            </div>

            <div class="explorer-header-actions">
              <button type="button" class="explorer-action-btn" id="btnExplorerCollapseAll"
                title="Collapse All Folders">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 14 10 14 10 20" />
                  <polyline points="20 10 14 10 14 4" />
                </svg>
              </button>
              <button type="button" class="explorer-action-btn" id="btnExplorerRefresh" title="Refresh Tree">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2" />
                </svg>
              </button>

              <!-- Overflow / More Options Menu (⋮) -->
              <div class="explorer-more-menu-wrap" id="explorerMoreMenuWrap">
                <button type="button" class="explorer-action-btn" id="btnExplorerMoreActions"
                  title="More Options (New File, New Folder, Upload Folder)" aria-label="More Options">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                    fill="currentColor">
                    <circle cx="12" cy="5" r="2" />
                    <circle cx="12" cy="12" r="2" />
                    <circle cx="12" cy="19" r="2" />
                  </svg>
                </button>

                <!-- Popover / Dropdown Menu Card -->
                <div class="explorer-dropdown-menu" id="explorerDropdownMenu" style="display: none;">
                  <div class="explorer-dropdown-header">
                    <span>EXPLORER ACTIONS</span>
                    <span class="explorer-target-dir-badge" id="explorerTargetDirBadge">Root</span>
                  </div>

                  <button type="button" class="explorer-dropdown-item" id="menuItemNewFile">
                    <span class="exp-item-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="12" y1="18" x2="12" y2="12" />
                        <line x1="9" y1="15" x2="15" y2="15" />
                      </svg>
                    </span>
                    <div class="exp-item-label">
                      <strong>+ New File</strong>
                      <span id="labelNewFileTarget">Create in active directory</span>
                    </div>
                  </button>

                  <button type="button" class="explorer-dropdown-item" id="menuItemNewFolder">
                    <span class="exp-item-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path
                          d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                        <line x1="12" y1="11" x2="12" y2="17" />
                        <line x1="9" y1="14" x2="15" y2="14" />
                      </svg>
                    </span>
                    <div class="exp-item-label">
                      <strong>+ New Folder</strong>
                      <span id="labelNewFolderTarget">Create folder in active location</span>
                    </div>
                  </button>

                  <div class="explorer-dropdown-divider"></div>

                  <button type="button" class="explorer-dropdown-item" id="menuItemUploadFolder">
                    <span class="exp-item-icon icon-upload">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="17 8 12 3 7 8" />
                        <line x1="12" y1="3" x2="12" y2="15" />
                      </svg>
                    </span>
                    <div class="exp-item-label">
                      <strong>+ Upload Folder</strong>
                      <span>Upload directory from local device</span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Hidden Native Input for Directory Upload -->
              <input type="file" id="explorerFolderUploadInput" webkitdirectory directory multiple
                style="display: none;" />

              <button type="button" class="explorer-action-btn explorer-close-btn" id="btnCloseFileExplorer"
                title="Close Explorer Sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
