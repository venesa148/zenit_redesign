            <!-- PANEL 2: Architecture Document Panel -->
            <div class="doc-panel-section" id="docPanelArchitecture">
              <div class="doc-summary-intro">
                <h2 class="doc-section-headline">System Architecture Overview</h2>
                <p class="doc-section-desc">Arsitektur berlapis (N-Tier) dengan Microservices, event-driven message
                  queue, dan database cluster.</p>
              </div>

              <!-- Architecture Layer Flow Diagram -->
              <div class="arch-diagram-flow">
                <!-- Layer 1: Client Layer -->
                <div class="arch-layer-row">
                  <span class="arch-layer-title">Presentation &amp; Client Layer</span>
                  <div class="arch-blocks-grid">
                    <div class="arch-block-card">
                      <span class="arch-block-name">Web Application</span>
                      <span class="arch-block-sub">Responsive Next.js &amp; Tailwind UI</span>
                      <span class="arch-tech-pill">Next.js 14 · SSR</span>
                    </div>
                    <div class="arch-block-card">
                      <span class="arch-block-name">Mobile Companion</span>
                      <span class="arch-block-sub">Warehouse &amp; Delivery Scanner</span>
                      <span class="arch-tech-pill">React Native / PWA</span>
                    </div>
                  </div>
                </div>

                <!-- Layer 2: API Gateway -->
                <div class="arch-layer-row">
                  <span class="arch-layer-title">API Gateway &amp; Auth</span>
                  <div class="arch-blocks-grid">
                    <div class="arch-block-card">
                      <span class="arch-block-name">Zenith API Gateway</span>
                      <span class="arch-block-sub">Rate Limiting, JWT Verification, RBAC</span>
                      <span class="arch-tech-pill">Kong / Envoy Proxy</span>
                    </div>
                  </div>
                </div>

                <!-- Layer 3: Domain Microservices -->
                <div class="arch-layer-row">
                  <span class="arch-layer-title">Domain Microservices</span>
                  <div class="arch-blocks-grid">
                    <div class="arch-block-card">
                      <span class="arch-block-name">Order &amp; Sales Service</span>
                      <span class="arch-block-sub">Order lifecycle &amp; workflow</span>
                      <span class="arch-tech-pill">Go Gin / gRPC</span>
                    </div>
                    <div class="arch-block-card">
                      <span class="arch-block-name">Inventory Service</span>
                      <span class="arch-block-sub">Stock tracking &amp; barcode ledger</span>
                      <span class="arch-tech-pill">Go / Node.js</span>
                    </div>
                    <div class="arch-block-card">
                      <span class="arch-block-name">Finance &amp; Ledger</span>
                      <span class="arch-block-sub">General ledger, invoice &amp; tax</span>
                      <span class="arch-tech-pill">Python FastAPI</span>
                    </div>
                  </div>
                </div>

                <!-- Layer 4: Data & Cache Layer -->
                <div class="arch-layer-row">
                  <span class="arch-layer-title">Storage &amp; Telemetry</span>
                  <div class="arch-blocks-grid">
                    <div class="arch-block-card">
                      <span class="arch-block-name">Primary Database</span>
                      <span class="arch-block-sub">PostgreSQL 16 Cluster + Timescale</span>
                      <span class="arch-tech-pill">PostgreSQL</span>
                    </div>
                    <div class="arch-block-card">
                      <span class="arch-block-name">In-Memory Cache</span>
                      <span class="arch-block-sub">Session store &amp; Hot product caching</span>
                      <span class="arch-tech-pill">Redis v7</span>
                    </div>
                    <div class="arch-block-card">
                      <span class="arch-block-name">Message Queue</span>
                      <span class="arch-block-sub">Async events &amp; PDF invoice export</span>
                      <span class="arch-tech-pill">RabbitMQ</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

