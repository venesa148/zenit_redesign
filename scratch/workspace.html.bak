          <!-- Middle Section: Project Timeline -->
          <div class="pm-card pm-card-timeline">
            <div class="pm-timeline-header">
              <div class="pm-timeline-title-area">
                <h2 class="pm-card-title">Project Timeline</h2>
                <span class="pm-timeline-sub">
                  <span>no dates — even sequence</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" x2="12" y1="16" y2="12" />
